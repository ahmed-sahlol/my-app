<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/product.css">
</head>

<body>
<%- include('../includes/navigation.ejs') %>
<main>
    <% if (prods.length > 0){ %>
        <div class="grid">
            <% for(let curr of prods){ %>
                <article class="card product-item">
                    <header class="card__header">
                        <h1 class="product__title"><%= curr.title %></h1>
                    </header>
                    <div class="card__image">
                        <img src="<%= curr.imageurl %>" alt="<%= curr.title %>">
                    </div>
                    <div class="card__content">
                        <h2 class="product__price"><%= curr.price %></h2>
                        <p class="product__description"><%= curr.dec %></p>
                    </div>
                    <div class="card__actions">
                        <a href="/admin/edit-product/<%= curr.id %>?edit=true" class="btn">Edit</a>

                        <form action="/admin/delete-product" method="POST">
                            <input type="hidden" name="productid" value="<%= curr.id %>">
                            <button class="btn" type="submit">Delete</button>
                        </form>

                    </div>
                </article>
            <% } %>
        </div>
    <% }else{ %>
        <h1>No products found now</h1>
    <% } %>
</main>
<%- include('../includes/end.ejs') %>
