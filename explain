// http.createServer : make a server that receiving requests and sending responses
const server = http.createServer((req, res) => {
    // This function is the "brain" of your server.
    // It runs every time a client connects and sends a request
    console.log(req.url, req.method, req.headers);
    //is a function that immediately and forcefully terminates the current Node.js
    // process.exit();
    const url = req.url;
    const method = req.method;
    if (url === '/') {
        res.setHeader('Content-Type', 'text/html');
        res.write('<html>');
        res.write('<head><title>Enter messege </title></head>')
        res.write('<boody> <form action = "/message" method = "POST"><input type = "text" name ="message"> <button type="submit">Send</button></form></body>');
        res.write('</html>');
        return res.end();
    }

    if (url === '/message' && method === 'POST') {
        const boody = [];
        /*
        When a client sends a large amount of data
        (like a file upload or even a typical form submission),
        Node.js doesn't give you the entire data body at once. Instead,
        it streams the data in small pieces (chunks) to keep the server efficient and non-blocking.
        */
        // listen in on to recive a chunk from user
        req.on('data', (chunk) => {
            boody.push(chunk);
        });
        // listen is end and now we accumalte cunks to get data
        return req.on('end', () => {
            // method combines all the individual Buffer chunks from the boody array into one large Buffer
            const parseboody = Buffer.concat(boody).toString();
            const message = parseboody.split('=')[0];
            fs.writeFileSync('message.txt', message); // stop code excute until file created
            // fs.writeFileSync('message.txt',message); // not bolck
            res.statusCode = 302;
            res.setHeader('Location', '/');
            return res.end();
        });
        // make file make his name is message.txt and write Dummy
        // fs.writeFileSync('message.txt','Dummy');
        // there more statue code 302 mean Redirection
        // res.statusCode = 302;
        // // go to location '/' mean home page
        // res.setHeader('Location','/');
        // return res.end();
    }

    res.setHeader('Content-Type', 'text/html');
    res.write('<html>');
    res.write('<head><title> My first program </title></head>')
    res.write('<boody><h1>hello my name is sahlol</h1> </boody>')
    res.write('</html>');
    res.end();
});

